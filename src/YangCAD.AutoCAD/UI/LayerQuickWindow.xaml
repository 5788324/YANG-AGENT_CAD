<Window x:Class="YangCAD.AutoCADHost.UI.LayerQuickWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="图层工具 · YangCAD" Width="540" Height="560" MinWidth="460" MinHeight="480"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Obsidian.xaml"/>
    <ResourceDictionary Source="Themes/SharedStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="10"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="10"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="10"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="10"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="图层工具" Style="{DynamicResource SectionTitle}"/>
    <TextBlock Margin="0,3,0,0" Text="按 Ctrl 或 Shift 多选图层，可批量开关、冻结或锁定。" TextWrapping="Wrap" Style="{DynamicResource MutedText}"/>
   </StackPanel>
   <Button Grid.Column="1" Content="图中点选对象" Style="{DynamicResource SecondaryButton}" Click="PickClick" VerticalAlignment="Center"/>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="SourceLayer" MinHeight="34" IsEditable="True" IsTextSearchEnabled="True" Style="{DynamicResource ParameterComboBox}" SelectionChanged="LayerChanged"/>
   <TextBox Grid.Column="2" x:Name="FilterBox" Height="34" Padding="10,6" VerticalContentAlignment="Center" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" TextChanged="FilterChanged" ToolTip="输入关键词筛选图层"/>
  </Grid>

  <Border Grid.Row="4" Style="{DynamicResource Card}" Padding="8">
   <ListBox x:Name="LayerListBox" SelectionMode="Extended" Style="{DynamicResource NavigationList}" SelectionChanged="LayerListSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left" Width="10" Height="10" Background="{Binding Color}" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       </DockPanel>
       <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" VerticalAlignment="Center" Style="{DynamicResource MutedText}" FontSize="11" Margin="8,0,0,0"/>
      </Grid>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
  </Border>

  <StackPanel Grid.Row="6">
   <TextBlock x:Name="LayerStatus" Margin="0,0,0,8" Style="{DynamicResource MutedText}" TextWrapping="Wrap"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="VisibilityButton" Grid.Column="0" Content="关闭图层" Style="{DynamicResource PrimaryButton}" Click="VisibilityClick"/>
    <Button x:Name="FreezeButton" Grid.Column="2" Content="冻结图层" Style="{DynamicResource PrimaryButton}" Click="FreezeClick"/>
    <Button x:Name="LockButton" Grid.Column="4" Content="锁定图层" Style="{DynamicResource PrimaryButton}" Click="LockClick"/>
   </Grid>
  </StackPanel>

  <Border Grid.Row="8" Style="{DynamicResource Card}" Padding="10,8">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="合并到：" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
    <ComboBox Grid.Column="1" x:Name="TargetLayer" MinHeight="32" IsEditable="True" IsTextSearchEnabled="True" Style="{DynamicResource ParameterComboBox}"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal">
     <Button Content="合并图层" Style="{DynamicResource SecondaryButton}" Click="MergeClick" Padding="12,6"/>
     <Button Content="关闭" IsCancel="True" Style="{DynamicResource SecondaryButton}" Padding="12,6" Margin="6,0,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
