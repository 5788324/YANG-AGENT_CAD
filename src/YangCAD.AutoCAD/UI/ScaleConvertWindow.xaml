<Window x:Class="YangCAD.AutoCADHost.UI.ScaleConvertWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="图纸比例转换 · YangCAD" Width="500" Height="550" MinWidth="460" MinHeight="510"
 WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Obsidian.xaml"/>
    <ResourceDictionary Source="Themes/SharedStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel>
   <TextBlock Text="图纸比例转换" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock x:Name="SelectionSummaryText" Text="已选择 0 个对象" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
  </StackPanel>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Style="{StaticResource Card}" Padding="12">
     <StackPanel>
      <TextBlock Text="绘图模式" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <RadioButton x:Name="StandardModeRadio" Content="标准模式（模型空间按 1:1 实尺寸绘制）" IsChecked="True" Style="{StaticResource ElegantRadioButton}" Checked="ModeChanged"/>
      <RadioButton x:Name="ScaledModeRadio" Content="缩尺绘图模式（模型空间不是按真实 1:1 绘制）" Style="{StaticResource ElegantRadioButton}" Checked="ModeChanged"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="比例设置" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="当前比例" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
       <ComboBox Grid.Column="1" x:Name="OldScaleCombo" IsEditable="True" Style="{StaticResource ParameterComboBox}" LostFocus="ScaleInputChanged" SelectionChanged="ScaleSelectionChanged"/>
      </Grid>
      <WrapPanel Margin="72,6,0,8">
       <Button Content="1:1" Tag="1:1" Click="QuickOldScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:20" Tag="1:20" Click="QuickOldScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:50" Tag="1:50" Click="QuickOldScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:100" Tag="1:100" Click="QuickOldScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:200" Tag="1:200" Click="QuickOldScaleClick" Style="{StaticResource ScalePillButton}"/>
      </WrapPanel>

      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="目标比例" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
       <ComboBox Grid.Column="1" x:Name="NewScaleCombo" IsEditable="True" Style="{StaticResource ParameterComboBox}" LostFocus="ScaleInputChanged" SelectionChanged="ScaleSelectionChanged"/>
      </Grid>
      <WrapPanel Margin="72,6,0,10">
       <Button Content="1:1" Tag="1:1" Click="QuickNewScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:20" Tag="1:20" Click="QuickNewScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:50" Tag="1:50" Click="QuickNewScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:100" Tag="1:100" Click="QuickNewScaleClick" Style="{StaticResource ScalePillButton}"/>
       <Button Content="1:200" Tag="1:200" Click="QuickNewScaleClick" Style="{StaticResource ScalePillButton}"/>
      </WrapPanel>

      <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7">
       <StackPanel>
        <TextBlock x:Name="FactorText" Text="几何倍率 1.0000" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModeHintText" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>

    <Border x:Name="BasePointPanel" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="缩放基点：" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <RadioButton x:Name="PickBasePointRadio" Content="图中拾取" IsChecked="True" Style="{StaticResource ElegantRadioButton}" Margin="0,0,24,0"/>
      <RadioButton x:Name="OriginBasePointRadio" Content="世界坐标 0,0,0" Style="{StaticResource ElegantRadioButton}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
     <StackPanel>
      <TextBlock Text="保持图纸出图大小" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <WrapPanel>
       <CheckBox x:Name="TextCheck" Content="文字大小" IsChecked="True" Style="{StaticResource ElegantCheckBox}" Margin="0,2,18,2"/>
       <CheckBox x:Name="DimensionCheck" Content="尺寸标注文字 / 箭头 / 间距" IsChecked="True" Style="{StaticResource ElegantCheckBox}" Margin="0,2,18,2"/>
       <CheckBox x:Name="LeaderCheck" Content="Leader / MLeader 文字与箭头" IsChecked="True" Style="{StaticResource ElegantCheckBox}" Margin="0,2,18,2"/>
       <CheckBox x:Name="HatchCheck" Content="Hatch 图案比例" IsChecked="True" Style="{StaticResource ElegantCheckBox}" Margin="0,2,18,2"/>
       <CheckBox x:Name="LinetypeCheck" Content="线型显示比例" IsChecked="True" Style="{StaticResource ElegantCheckBox}" Margin="0,2,0,2"/>
      </WrapPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="支持 Ctrl+Z 一步撤销" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Click="CancelClick"/>
   <Button Grid.Column="3" Content="开始转换" Style="{StaticResource PrimaryButton}" Click="StartClick"/>
  </Grid>
 </Grid>
</Window>
