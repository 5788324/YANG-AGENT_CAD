<Window x:Class="YangCAD.AutoCADHost.UI.ScaleConvertWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="图纸比例转换" Width="540" Height="650" MinWidth="500" MinHeight="610"
 WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Obsidian.xaml"/>
    <ResourceDictionary Source="Themes/SharedStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="14"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel>
   <TextBlock Text="图纸比例转换" Style="{StaticResource TitleText}"/>
   <TextBlock x:Name="SelectionSummaryText" Text="已选择 0 个对象" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
  </StackPanel>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <TextBlock Text="绘图方式" Style="{StaticResource SectionTitle}"/>
    <Border Style="{StaticResource Card}" Margin="0,9,0,0">
     <StackPanel>
      <RadioButton x:Name="StandardModeRadio" Content="标准模式（模型空间按 1:1 实尺寸绘制）" IsChecked="True" Style="{StaticResource ElegantRadioButton}" Checked="ModeChanged"/>
      <TextBlock Text="几何尺寸保持不变，只调整模型空间注释/线型/填充的显示尺度。" Style="{StaticResource MutedText}" Margin="28,0,0,8" TextWrapping="Wrap"/>
      <RadioButton x:Name="ScaledModeRadio" Content="缩尺绘图模式（模型空间不是按真实 1:1 绘制）" Style="{StaticResource ElegantRadioButton}" Checked="ModeChanged"/>
      <TextBlock Text="例如实际 1000 在 1:5 图中画成 200；转换时会实际缩放几何。" Style="{StaticResource MutedText}" Margin="28,0,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>

    <TextBlock Text="比例" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
    <Border Style="{StaticResource Card}" Margin="0,9,0,0">
     <StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="当前比例" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
       <ComboBox Grid.Column="1" x:Name="OldScaleCombo" IsEditable="True" Style="{StaticResource ParameterComboBox}" LostFocus="ScaleInputChanged" SelectionChanged="ScaleSelectionChanged"/>
      </Grid>
      <Grid Margin="0,10,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="目标比例" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
       <ComboBox Grid.Column="1" x:Name="NewScaleCombo" IsEditable="True" Style="{StaticResource ParameterComboBox}" LostFocus="ScaleInputChanged" SelectionChanged="ScaleSelectionChanged"/>
      </Grid>
      <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock x:Name="FactorText" Text="几何倍率 1.0000" FontWeight="SemiBold"/>
        <TextBlock x:Name="ModeHintText" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>

    <StackPanel x:Name="BasePointPanel">
     <TextBlock Text="缩放基点" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
     <Border Style="{StaticResource Card}" Margin="0,9,0,0">
      <StackPanel Orientation="Horizontal">
       <RadioButton x:Name="PickBasePointRadio" Content="图中拾取" IsChecked="True" Style="{StaticResource ElegantRadioButton}" Margin="0,0,28,0"/>
       <RadioButton x:Name="OriginBasePointRadio" Content="世界坐标 0,0,0" Style="{StaticResource ElegantRadioButton}"/>
      </StackPanel>
     </Border>
    </StackPanel>

    <TextBlock Text="保持纸面表现" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
    <Border Style="{StaticResource Card}" Margin="0,9,0,0">
     <StackPanel>
      <CheckBox x:Name="TextCheck" Content="文字大小" IsChecked="True" Style="{StaticResource ElegantCheckBox}"/>
      <CheckBox x:Name="DimensionCheck" Content="尺寸标注文字 / 箭头 / 间距" IsChecked="True" Style="{StaticResource ElegantCheckBox}"/>
      <CheckBox x:Name="LeaderCheck" Content="Leader / MLeader 文字与箭头" IsChecked="True" Style="{StaticResource ElegantCheckBox}"/>
      <CheckBox x:Name="HatchCheck" Content="Hatch 图案比例" IsChecked="True" Style="{StaticResource ElegantCheckBox}"/>
      <CheckBox x:Name="LinetypeCheck" Content="线型显示比例" IsChecked="True" Style="{StaticResource ElegantCheckBox}"/>
      <TextBlock Text="注释性对象、Xref、图片/PDF/DGN/DWF、Civil 3D/AEC/Proxy 对象第一版会安全跳过。" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="YGSCALE · 单事务 · 目标一次 Ctrl+Z" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}" Click="CancelClick"/>
   <Button Grid.Column="3" Content="开始转换" Style="{StaticResource PrimaryButton}" Click="StartClick"/>
  </Grid>
 </Grid>
</Window>
