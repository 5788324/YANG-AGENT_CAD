<Window x:Class="YangCAD.AutoCADHost.UI.ControlCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YangCAD 控制中心" Width="860" Height="640" MinWidth="760" MinHeight="540"
 WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Obsidian.xaml"/>
    <ResourceDictionary Source="Themes/SharedStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="YangCAD" Style="{StaticResource TitleText}"/>
   <TextBlock Text="控制中心 · 系统设置 / 快捷键 / 关于" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
  </StackPanel>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="NavList" Style="{StaticResource NavigationList}" SelectionChanged="NavigationChanged" SelectedIndex="0">
    <ListBoxItem Tag="Settings">系统设置</ListBoxItem>
    <ListBoxItem Tag="Shortcuts">快捷键</ListBoxItem>
    <ListBoxItem Tag="About">关于</ListBoxItem>
   </ListBox>
   <Grid Grid.Column="2">
    <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="系统设置" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="保持个人工具箱简洁；主题设置会同步到全部 YangCAD 窗口。" Style="{StaticResource MutedText}" Margin="0,4,0,10"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="界面主题" FontWeight="SemiBold"/>
        <ListBox x:Name="ThemeList" Style="{StaticResource ThemeList}" SelectionChanged="ThemeChanged" Margin="0,10,0,0">
         <ListBoxItem Tag="Obsidian">墨曜 · Obsidian</ListBoxItem>
         <ListBoxItem Tag="Porcelain">月瓷 · Porcelain</ListBoxItem>
         <ListBoxItem Tag="Mist">雾蓝 · Mist</ListBoxItem>
        </ListBox>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="ShortcutsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="快捷键设置" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="为常用 YangCAD 功能分配命令缩写。Ctrl / Shift 组合键使用 CAD 原生 CUI。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="管理我的快捷键" FontWeight="SemiBold"/>
        <TextBlock Text="查看当前绑定，检查是否与 CAD 原有快捷键冲突，一键备份并保存。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
        <Button Content="打开快捷键面板" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OpenShortcutsClick"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="关于 YangCAD" Style="{StaticResource SectionTitle}"/>
      <Border Style="{StaticResource AccentCard}" Margin="0,10,0,0">
       <StackPanel>
        <TextBlock Text="YangCAD" FontSize="30" FontWeight="SemiBold"/>
        <TextBlock Text="CAD 工具箱 · 图纸处理 · AI 自动化" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
        <TextBlock x:Name="ProductVersionText" Text="v0.10.0-dev" Margin="0,12,0,0" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Text="开发预览版 · 新增功能尚待 Windows / AutoCAD 实机验证" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="产品定位" FontWeight="SemiBold"/>
        <TextBlock Text="面向个人工程工作流的本地 CAD 工具箱。可停靠工具面板处理日常绘图，Ribbon 提供轻量入口，MCP 提供 AI 调用能力。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="本机运行信息" FontWeight="SemiBold"/>
        <TextBlock x:Name="AboutEnvironmentText" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,12,0,0">
         <Button Content="复制诊断信息" Style="{StaticResource SecondaryButton}" Click="CopyAboutClick" Margin="0,0,8,8"/>
         <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Click="OpenLogsClick" Margin="0,0,8,8"/>
         <Button Content="GitHub 项目" Style="{StaticResource SecondaryButton}" Click="OpenProjectClick" Margin="0,0,0,8"/>
        </WrapPanel>
       </StackPanel>
      </Border>
      <TextBlock Text="© 2026 YangCAD。个人开发项目，使用 AI 辅助开发。非 Autodesk 官方产品；第三方插件参考资料及其著作权归各自权利人。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>

  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Local First · Personal Toolbox" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="关闭" Style="{StaticResource PrimaryButton}" Click="CloseClick"/>
  </Grid>
 </Grid>
</Window>
