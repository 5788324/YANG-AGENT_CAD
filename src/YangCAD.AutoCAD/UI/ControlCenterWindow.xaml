<Window x:Class="YangCAD.AutoCADHost.UI.ControlCenterWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YangCAD 控制中心" Width="860" Height="640" MinWidth="760" MinHeight="540"
 WindowStartupLocation="CenterOwner"
 Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Themes/Obsidian.xaml"/>
    <ResourceDictionary Source="Themes/SharedStyles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="YangCAD" Style="{StaticResource TitleText}"/>
   <TextBlock Text="控制中心 · 系统设置 / 关于" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
  </StackPanel>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="NavList" Style="{StaticResource NavigationList}" SelectionChanged="NavigationChanged" SelectedIndex="0">
    <ListBoxItem Tag="Settings">系统设置</ListBoxItem>
    <ListBoxItem Tag="About">关于</ListBoxItem>
   </ListBox>
   <Grid Grid.Column="2">
    <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="系统设置" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="保持个人工具箱简洁；主题设置会同步到全部 YangCAD 窗口。" Style="{StaticResource MutedText}" Margin="0,4,0,10"/>
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="界面主题" FontWeight="SemiBold"/>
        <ListBox x:Name="ThemeList" Style="{StaticResource ThemeList}" SelectionChanged="ThemeChanged" Margin="0,10,0,0">
         <ListBoxItem Tag="Obsidian">墨曜 · Obsidian</ListBoxItem>
         <ListBoxItem Tag="Porcelain">月瓷 · Porcelain</ListBoxItem>
         <ListBoxItem Tag="Mist">雾蓝 · Mist</ListBoxItem>
        </ListBox>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="关于 YangCAD" Style="{StaticResource SectionTitle}"/>
      <Border Style="{StaticResource AccentCard}" Margin="0,10,0,0">
       <StackPanel>
        <TextBlock Text="YangCAD" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="AutoCAD / Civil 3D 个人生产力工具" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
        <TextBlock x:Name="ProductVersionText" Text="Version 0.9.0-dev" Margin="0,12,0,0" FontWeight="SemiBold"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="开发声明" FontWeight="SemiBold"/><TextBlock Text="YangCAD 是面向个人工程工作的 AutoCAD / Civil 3D 生产力工具，由项目作者独立开发与维护。项目开发过程中使用 AI 辅助完成部分代码编写、架构设计、测试、文档整理与自动化任务。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="版权" FontWeight="SemiBold"/><TextBlock Text="Copyright © 2026 YangCAD · All Rights Reserved.&#x0a;本软件为个人开发和使用项目。未经许可，请勿擅自复制、分发、出售或修改后重新发布。" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="运行环境" FontWeight="SemiBold"/><TextBlock x:Name="AboutEnvironmentText" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"/><WrapPanel Margin="0,12,0,0"><Button Content="复制版本信息" Style="{StaticResource SecondaryButton}" Click="CopyAboutClick" Margin="0,0,8,0"/><Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Click="OpenLogsClick"/></WrapPanel></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Grid>

  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Local First · Personal Toolbox" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
   <Button Grid.Column="1" Content="关闭" Style="{StaticResource PrimaryButton}" Click="CloseClick"/>
  </Grid>
 </Grid>
</Window>
