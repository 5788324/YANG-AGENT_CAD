<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CadYear Condition="'$(CadYear)' == ''">2024</CadYear>
    <AcadRoot Condition="'$(AcadRoot)' == ''">C:\Program Files\Autodesk\AutoCAD $(CadYear)</AcadRoot>
    <TargetFramework Condition="'$(CadYear)' == '2021' Or '$(CadYear)' == '2022' Or '$(CadYear)' == '2023' Or '$(CadYear)' == '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(CadYear)' == '2025' Or '$(CadYear)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(CadYear)' == '2027'">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>YangCAD.AutoCAD</AssemblyName>
    <RootNamespace>YangCAD.AutoCADHost</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\bin\$(CadYear)\AutoCAD\</OutputPath>
    <DefineConstants>$(DefineConstants);ACAD_$(CadYear)</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)' == 'net48'">$(DefineConstants);YANGCAD_NETFRAMEWORK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\YangCAD.Core\YangCAD.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="UI\Icons\ControlCenter32.png" />
    <Resource Include="UI\Icons\Mcp32.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\mcp\Start-YangCAD-Mcp.ps1"><LogicalName>YangCAD.Runtime.Mcp.Start-YangCAD-Mcp.ps1</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\mcp\pyproject.toml"><LogicalName>YangCAD.Runtime.Mcp.pyproject.toml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\mcp\yangcad_mcp\__init__.py"><LogicalName>YangCAD.Runtime.Mcp.yangcad_mcp.__init__.py</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\mcp\yangcad_mcp\batch.py"><LogicalName>YangCAD.Runtime.Mcp.yangcad_mcp.batch.py</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\mcp\yangcad_mcp\extensions.py"><LogicalName>YangCAD.Runtime.Mcp.yangcad_mcp.extensions.py</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\mcp\yangcad_mcp\gateway.py"><LogicalName>YangCAD.Runtime.Mcp.yangcad_mcp.gateway.py</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\mcp\yangcad_mcp\server.py"><LogicalName>YangCAD.Runtime.Mcp.yangcad_mcp.server.py</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\workers\ImageEmbed\Start-YangCAD-ImageEmbed.ps1"><LogicalName>YangCAD.Runtime.ImageEmbed.Start-YangCAD-ImageEmbed.ps1</LogicalName></EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AcCoreMgd"><HintPath>$(AcadRoot)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AcadRoot)\AcDbMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcMgd"><HintPath>$(AcadRoot)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(AcadRoot)\AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
